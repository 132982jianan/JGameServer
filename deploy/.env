# JGameServer local Docker Compose defaults.
# start-server.bat passes this file explicitly with --env-file.

NODE_IMAGE=eclipse-temurin:21-jre
NACOS_IMAGE=nacos/nacos-server:v2.4.3
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:6.2-alpine

# host 留空规则：打包的 conf/* 默认值不含 host 键，缺失键回落到代码里
# 的环境变量默认值（NACOS_HOST/MONGO_HOST/REDIS_HOST/MONGO_URI，缺省 127.0.0.1）。
# Compose 已为容器注入这些变量指向 nacos/mongo/redis 服务名。
