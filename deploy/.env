# JGameServer local Docker Compose defaults.
# start-server.bat passes this file explicitly with --env-file.

NODE_IMAGE=eclipse-temurin:21-jre
NACOS_IMAGE=nacos/nacos-server:v2.4.3
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:6.2-alpine

# conf/ 默认值里 host 均可被环境变量覆盖（NACOS_HOST/MONGO_HOST/REDIS_HOST）。
# 注意：nacos.yml/mongo.yml/redis.yml 的 host 解析需配合 env override：
#   nacos.yml host: ${NACOS_HOST} 不生效（yml 不做变量替换），
#   因此 conf 目录挂载到容器 /app/conf，首次部署时由 envsubst 或手工改。
# 简化方案：Nacos 首次发布配置后，直接改 Nacos 上的配置即可（本项目默认发布机制）。
